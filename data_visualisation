# -*- coding: utf-8 -*-
"""
Visualize weekly sensor data with automatic gap separation
========================================================================
Plots one environmental variable against time, splitting weeks that are
more than a month apart into separate subplots.

Reads directly from the master DataFrame `data` (data_import_optimised.py).
Weeks are slices of that table (optimised_weekly_groupings.py), and the
plotted x/y values are views of its columns -- no per-week or per-chunk
copies are made.

Settings:
    VARIABLE_TO_PLOT -- column name in `data` (see VARIABLES), e.g. "co2"
    WEEKS_TO_PLOT    -- "all", a week number, a date, or a list of those
    MARKER_SIZE      -- dot size
    CONNECT_POINTS   -- draw lines between readings, or dots only
    MAX_POINTS_TOTAL -- thin each plot to roughly this many points (stride)
    POINT_ALPHA      -- dot transparency
========================================================================
"""

import math

import matplotlib.pyplot as plt
import pandas as pd

from data_import import data, VARIABLES, VARIABLE_TO_MODEL, TIME_COL
from weekly_groupings import group_by_week

# ------------------------------------------------------------------
# Human-changeable settings
# ------------------------------------------------------------------ 
WEEKS_TO_PLOT = "all"

MARKER_SIZE = 2            # dot size (scatter "s" units)
CONNECT_POINTS = False     # False = dots only; True = connect with lines
MAX_POINTS_TOTAL = None    # e.g. 300 -- thin each subplot to about this many points
POINT_ALPHA = 0.75         # transparency (0-1)
# ------------------------------------------------------------------


def number_weeks(weekly_groups):
    """Assigns each week a 1-indexed number in chronological order."""
    return {i + 1: week for i, week in enumerate(sorted(weekly_groups))}


def print_available_weeks(week_numbers):
    print("Available weeks:")
    for number, week_start in week_numbers.items():
        print(f"  {number}: week of {week_start.date()}")


def _merge_runs(slices):
    """Merges slices that touch end-to-end, so adjacent weeks become one view."""
    runs = []
    for sl in slices:
        if runs and runs[-1].stop == sl.start:
            runs[-1] = slice(runs[-1].start, sl.stop)
        else:
            runs.append(sl)
    return runs


def plot_separated_by_gaps(variable=VARIABLE_TO_MODEL, weeks_to_plot=WEEKS_TO_PLOT,
                           gap_threshold_days=31):
    """
    Draws selected weeks, splitting them into separate subplots whenever
    consecutive weeks are more than `gap_threshold_days` apart.
    """
    display_name, unit = VARIABLES[variable]
    ts = data[TIME_COL]        # references to master columns, not copies
    values = data[variable]

    weekly_groups = group_by_week(data)   # {week_start: slice into `data`}
    week_numbers = number_weeks(weekly_groups)

    if weeks_to_plot == "all":
        selected_weeks = sorted(weekly_groups)
    else:
        requested = ([weeks_to_plot] if isinstance(weeks_to_plot, (int, str, pd.Timestamp))
                     else list(weeks_to_plot))
        selected_weeks, missing = [], []
        for item in requested:
            if isinstance(item, int):
                week = week_numbers.get(item)
            else:
                week = pd.Timestamp(item)
                week = week if week in weekly_groups else None
            if week is None:
                missing.append(item)
            else:
                selected_weeks.append(week)
        selected_weeks = sorted(set(selected_weeks))
        if missing:
            print(f"[warning] no data for requested week number/date(s): {missing}")

    if not selected_weeks:
        print("No weeks to plot -- check WEEKS_TO_PLOT against the available weeks:")
        print_available_weeks(week_numbers)
        return None

    # Split into chunks wherever adjacent selected weeks are > gap_threshold_days apart.
    gap = pd.Timedelta(days=gap_threshold_days)
    week_chunks = [[selected_weeks[0]]]
    for prev_week, curr_week in zip(selected_weeks[:-1], selected_weeks[1:]):
        if curr_week - prev_week > gap:
            week_chunks.append([curr_week])
        else:
            week_chunks[-1].append(curr_week)

    fig, axes = plt.subplots(len(week_chunks), 1, figsize=(12, 4 * len(week_chunks)),
                             squeeze=False)

    for i, (ax, chunk) in enumerate(zip(axes[:, 0], week_chunks)):
        runs = _merge_runs([weekly_groups[w] for w in chunk])
        total = sum(r.stop - r.start for r in runs)
        stride = 1 if MAX_POINTS_TOTAL is None else max(1, math.ceil(total / MAX_POINTS_TOTAL))

        for j, run in enumerate(runs):
            view = slice(run.start, run.stop, stride)        # still a view of the master
            x, y = ts.iloc[view], values.iloc[view]
            label = display_name if (i == 0 and j == 0) else "_nolegend_"
            if CONNECT_POINTS:
                ax.plot(x, y, marker="o", markersize=MARKER_SIZE ** 0.5,
                        alpha=POINT_ALPHA, label=label)
            else:
                ax.scatter(x, y, s=MARKER_SIZE, alpha=POINT_ALPHA,
                           edgecolors="none", label=label)

        start = chunk[0]
        end = chunk[-1] + pd.Timedelta(days=7)
        ax.set_title(f"{display_name} -- Period: {start.date()} to {end.date()} ({len(chunk)} week(s))")
        ax.set_xlabel("Timestamp")
        ax.set_ylabel(f"{display_name} ({unit})")
        ax.tick_params(axis="x", rotation=30)
        ax.grid(True, alpha=0.3, linestyle="--")
        ax.set_xlim(start, end)
        if i == 0:
            ax.legend(loc="upper right")

    fig.tight_layout()
    return fig


if __name__ == "__main__":
    fig = plot_separated_by_gaps()
    if fig is not None:
        fig.savefig("separated_gaps_variable_plot.png", dpi=150)
        plt.show()

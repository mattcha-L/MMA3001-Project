"""Group sensor readings by calendar week and/or by sensor id."""

import pandas as pd
from data_import import row_ids, TIME_TO_MODEL, VARIABLE_TO_MODEL

_DAY_BEFORE = {"MON": "SUN", "TUE": "MON", "WED": "TUE", "THU": "WED",
               "FRI": "THU", "SAT": "FRI", "SUN": "SAT"}


def group_by_week(timestamps, week_start_day="MON", **columns):
    """
    Groups readings into calendar weeks based on `timestamps` and drops undated rows.
    """
    # Pass arrays/Series directly without converting to lists
    df = pd.DataFrame({"timestamps": pd.to_datetime(timestamps)})
    for name, values in columns.items():
        df[name] = values

    undated = df[df["timestamps"].isna()]
    df = df.dropna(subset=["timestamps"]).copy()
    if len(undated):
        print(f"[warning] {len(undated)} reading(s) had no timestamps and were excluded from weekly grouping")

    timestamps_series = df["timestamps"]
    week_basis = timestamps_series.dt.tz_localize(None) if timestamps_series.dt.tz is not None else timestamps_series
    anchor = _DAY_BEFORE[week_start_day.upper()]
    df["week_start"] = week_basis.dt.to_period(f"W-{anchor}").apply(lambda p: p.start_time)

    weekly_groups = {
        week_start: group.drop(columns="week_start").reset_index(drop=True)
        for week_start, group in df.groupby("week_start")
    }

    return weekly_groups


if __name__ == "__main__":
    weekly_groups = group_by_week(
        TIME_TO_MODEL,
        row_id=row_ids, VARIABLE_TO_MODEL=VARIABLE_TO_MODEL[0], TIME_TO_MODEL=TIME_TO_MODEL,
    )

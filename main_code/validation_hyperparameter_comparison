# -*- coding: utf-8 -*-
"""Hyperparameter sweep for the incrementally trained neural network.

Trains every hidden-layer structure with each epochs-per-week option. Activation
and L2 alpha come from optimised_neural_network.py.

Selection and reporting use validation data only; the test week is never used.
The recommended configuration is the cheapest (fastest) one whose validation
RMSE is within TOLERANCE of the best, since small differences are mostly noise.

The structure and seed are set via the module-level settings in
optimised_neural_network (NN_HIDDEN_LAYERS, RANDOM_SEED) and restored afterwards.

"""

import contextlib
import io
import time

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

import neural_network as nn
from weekly_groupings import group_by_week
from data_visualisation import number_weeks

# ------------------------------------------------------------------
# Human-changeable settings
# ------------------------------------------------------------------
ARCHITECTURES = [
    (32, 32), (64, 64),           # two layers: most likely sweet spot
    (32, 32, 32), (32, 64, 32),   # uniform three layer
    (32, 32, 64, 32),             # your current structure, as the baseline to beat
    (32, 32, 64, 32, 32),         # deeper variant of your current structure
]
EPOCH_OPTIONS = [10, 20, 30]      # epochs-per-week values tried for every structure

SEEDS = [0]                       # e.g. [0, 1, 2] to average out random-init noise (3x the time)
TOLERANCE = 0.015                 # "within 1.5% of best RMSE" counts as equally good

# Extra keyword args passed to every train_incremental call, e.g. to speed up the sweep:
#   SWEEP_KWARGS = {"trial_weeks": list(range(30, 49))}
SWEEP_KWARGS = {}
# ------------------------------------------------------------------

N_INPUTS = 5   # elapsed time + sin/cos(hour) + sin/cos(day of week)


def n_params(arch, n_inputs=N_INPUTS):
    """Counts trainable parameters (weights + biases) of an MLP with one output.

    Args:
        arch: Tuple of hidden-layer sizes.
        n_inputs: Number of input features.

    Returns:
        Total parameter count.
    """
    sizes = [n_inputs, *arch, 1]
    return sum(a * b + b for a, b in zip(sizes[:-1], sizes[1:]))


def run_config(arch, epochs, weekly, week_numbers):
    """Trains one configuration once per seed and scores it on validation.

    Args:
        arch: Tuple of hidden-layer sizes.
        epochs: Epochs per week.
        weekly: Precomputed week slices, shared across runs.
        week_numbers: Precomputed week numbering, shared across runs.

    Returns:
        Tuple of (summary row dict, results from the best seed), or None if
        any run produced no validation result.
    """
    rmses, seconds, best = [], [], None
    for seed in SEEDS:
        nn.NN_HIDDEN_LAYERS = arch      # read by train_incremental at call time
        nn.RANDOM_SEED = seed
        t0 = time.perf_counter()
        with contextlib.redirect_stdout(io.StringIO()):     # silence per-week progress output
            r = nn.train_incremental(epochs_per_week=epochs, validate_every=10 ** 9,
                                     weekly=weekly, week_numbers=week_numbers, **SWEEP_KWARGS)
        seconds.append(time.perf_counter() - t0)
        if r is None or not r["validation_history"]:
            return None
        rmse = r["validation_history"][-1]["rmse"]    # validation after the final week only
        if best is None or rmse < min(rmses):
            best = r
        rmses.append(rmse)
    row = {"structure": arch, "epochs": epochs, "params": n_params(arch),
           "val_rmse": float(np.mean(rmses)),
           "val_rmse_std": float(np.std(rmses)) if len(rmses) > 1 else 0.0,
           "seconds": float(np.mean(seconds))}
    return row, best


def plot_results(df, recommended):
    """Plots validation RMSE against training time for every configuration.

    Args:
        df: Sweep results with structure, epochs, params, val_rmse and seconds columns.
        recommended: Row of `df` to circle as the recommended configuration.

    Returns:
        The matplotlib Figure.
    """
    fig, ax = plt.subplots(figsize=(10, 6))
    ax.scatter(df["seconds"], df["val_rmse"], s=25 + df["params"] / 60, alpha=0.6, color="steelblue")
    ax.scatter([recommended["seconds"]], [recommended["val_rmse"]], s=160, facecolors="none",
               edgecolors="crimson", linewidths=2, label="Recommended")
    for _, r in df.iterrows():
        ax.annotate(f"{r['structure']}, {r['epochs']}ep", (r["seconds"], r["val_rmse"]),
                    fontsize=7, xytext=(4, 4), textcoords="offset points")
    ax.set_xlabel("Training time per run (s)")
    ax.set_ylabel("Validation RMSE")
    ax.set_title("Validation error vs. training cost (marker size ~ parameter count)")
    ax.grid(True, alpha=0.3, linestyle="--")
    ax.legend()
    fig.tight_layout()
    return fig


def main():
    """Runs the sweep, saves the results and plot, and prints the recommendation.

    Returns:
        Tuple of (results DataFrame, results of the recommended run), or None
        if no run succeeded.
    """
    print(f"Using {nn.__file__}")
    saved = (nn.NN_HIDDEN_LAYERS, nn.RANDOM_SEED)
    try:
        weekly = group_by_week(nn.data)            # computed once, shared by every run
        week_numbers = number_weeks(weekly)

        configs = [(a, e) for a in ARCHITECTURES for e in EPOCH_OPTIONS]
        rows, store, t_start = [], {}, time.perf_counter()
        print(f"{len(configs)} runs ({len(ARCHITECTURES)} structures x {len(EPOCH_OPTIONS)} epoch options) "
              f"x {len(SEEDS)} seed(s)")
        for i, (arch, epochs) in enumerate(configs, start=1):
            out = run_config(arch, epochs, weekly, week_numbers)
            if out is None:
                print(f"[{i}/{len(configs)}] {arch} epochs={epochs}: no validation result -- "
                      f"check VALIDATION_WEEKS / training weeks. Skipping.")
                continue
            row, result = out
            rows.append(row)
            store[(arch, epochs)] = result
            elapsed = time.perf_counter() - t_start
            eta = elapsed / i * (len(configs) - i)
            print(f"[{i}/{len(configs)}] {str(arch):<16} epochs={epochs:<4} -> val RMSE {row['val_rmse']:.3f} "
                  f"({row['seconds']:.0f}s) | elapsed {elapsed:.0f}s, ETA ~{eta:.0f}s")
    finally:
        nn.NN_HIDDEN_LAYERS, nn.RANDOM_SEED = saved   # leave the module as we found it

    if not rows:
        print("[error] no successful runs.")
        return None

    df = pd.DataFrame(rows).sort_values("val_rmse").reset_index(drop=True)

    # ---- Pick: cheapest configuration within TOLERANCE of the best validation RMSE ----
    best = df.iloc[0]
    close = df[df["val_rmse"] <= best["val_rmse"] * (1 + TOLERANCE)]
    recommended = close.sort_values("seconds").iloc[0]

    pd.set_option("display.width", 160)
    print("\nResults by validation RMSE:")
    print(df.to_string(float_format=lambda v: f"{v:.4g}"))
    print(f"\nLowest validation RMSE : {best['structure']}, {best['epochs']} epochs -> "
          f"{best['val_rmse']:.3f} ({best['seconds']:.0f}s)")
    print(f"RECOMMENDED (cheapest within {TOLERANCE:.1%}): {recommended['structure']}, "
          f"{recommended['epochs']} epochs -> {recommended['val_rmse']:.3f} ({recommended['seconds']:.0f}s)")

    # ---- Validation score for the recommended configuration (test data is not used) ----
    result = store[(recommended["structure"], int(recommended["epochs"]))]
    val = result["validation_history"][-1]
    unit = result.get("unit", "")
    parts = [f"RMSE {recommended['val_rmse']:.3f} {unit}".strip()]
    if "mae" in val:
        parts.append(f"MAE {val['mae']:.3f}")
    rr = val.get("rrmse", val.get("rRMSE"))
    if rr is not None:
        parts.append(f"rRMSE {rr * 100:.3f}%")
    print("Validation (recommended configuration): " + ", ".join(parts))
    nn.plot_incremental_evaluation(result)
    plot_results(df, recommended)
    plt.show()
    return df, result


if __name__ == "__main__":
    main()

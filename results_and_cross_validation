import time

import matplotlib.pyplot as plt
import numpy as np

from data_import import row_ids, created_at
from weekly_groupings import group_by_week
from data_visualisation import VARIABLE_TO_MODEL, TIME_TO_MODEL, number_weeks, _thin
from neural_network import PLOT_MAX_POINTS, EPOCHS_PER_WEEK, TRIAL_WEEKS, train_incremental, plot_incremental_evaluation, plot_test_week_only

RUN_CROSS_VALIDATION = True         # also run walk-forward cross-validation (see cross_validate() below)
CV_MIN_TRAIN_WEEKS = 3              # smallest training window a fold is allowed to start from
CV_FOLD_STEP = 17                    # run every Nth fold instead of every single one -- THE MAIN RUNTIME
                                     # KNOB. Each fold retrains a fresh model from scratch on an expanding
                                     # window, so with W available weeks and CV_FOLD_STEP=1, total work is
                                     # roughly W^2/2 "week-trainings" (e.g. 13 weeks -> ~75, a ~6x
                                     # redundancy versus training once). CV_FOLD_STEP=2 tests every other
                                     # week and roughly HALVES both the fold count and the total runtime;
                                     # CV_FOLD_STEP=3 roughly a third, and so on.
                                     
def cross_validate(variable_key=VARIABLE_TO_MODEL, min_train_weeks=CV_MIN_TRAIN_WEEKS,
                    epochs_per_week=EPOCHS_PER_WEEK, fold_step=CV_FOLD_STEP):
    """
    Walk-forward cross-validation. For fold k, trains a FRESH model
    (from scratch, independent of every other fold) on the first k
    available weeks and tests on week k+1 -- so every fold respects
    chronological order and performance is assessed across many
    different train/test splits, not just one. fold_step > 1 skips
    folds (tests every Nth week instead of every week) to directly
    cut runtime -- see CV_FOLD_STEP's comment for why this is the
    main cost driver.

    Prints an upfront estimate of total runtime (timed from the first
    fold actually run) before committing to the rest, since walk-
    forward CV's cost can be substantial on large datasets.

    Returns a list of per-fold dicts (n_train_weeks, test_week_number,
    test_week_start, rmse, mae, r2) and prints a summary across folds.
    """
    
    _, display_name, unit = VARIABLE_TO_MODEL

    weekly_groups, _ = group_by_week(created_at, row_id=row_ids, value=VARIABLE_TO_MODEL[0])
    week_numbers = number_weeks(weekly_groups)
    all_weeks = sorted(week_numbers.values())

    if len(all_weeks) <= min_train_weeks:
        print(f"[error] {display_name}: only {len(all_weeks)} week(s) available, need more than "
              f"CV_MIN_TRAIN_WEEKS={min_train_weeks} to run even one fold.")
        return []

    fold_ks = list(range(min_train_weeks, len(all_weeks), fold_step))
    total_week_trainings = sum(fold_ks)
    print(f"{display_name}: {len(fold_ks)} fold(s) planned (CV_FOLD_STEP={fold_step}), "
          f"{total_week_trainings} total week-trainings (vs {len(all_weeks)} weeks of unique data -- "
          f"a {total_week_trainings / len(all_weeks):.1f}x redundancy, inherent to walk-forward CV).")

    fold_results = []
    cv_t0 = time.perf_counter()
    for i, k in enumerate(fold_ks):
        train_weeks_fold = TRIAL_WEEKS[:k]
        test_week_fold = all_weeks[k]
        test_week_number = next(n for n, w in week_numbers.items() if w == test_week_fold)
        print(f"\n--- Fold {i + 1}/{len(fold_ks)}: train on weeks 1..{k}, "
              f"test on week {test_week_number} ({test_week_fold.date()}) ---")

        result = train_incremental(variable_key, trial_weeks=train_weeks_fold, validation_weeks=[],
                                   test_weeks=[test_week_fold], epochs_per_week=epochs_per_week)

        if i == 0:
            elapsed = time.perf_counter() - cv_t0
            est_total = elapsed * total_week_trainings / k
            print(f"[estimate] first fold took {elapsed:.1f}s ({k} week-trainings) -- "
                  f"projected total for all {len(fold_ks)} fold(s): ~{est_total:.0f}s "
                  f"({est_total / 60:.1f} min). Lower CV_FOLD_STEP's effect is the opposite -- "
                  f"raise it, or raise CV_MIN_TRAIN_WEEKS, to cut this down.")

        if result is not None and "rmse" in result:
            fold_results.append({
                "fold": k - min_train_weeks + 1, "n_train_weeks": k,
                "test_week_number": test_week_number, "test_week_start": test_week_fold,
                "rmse": result["rmse"], "mae": result["mae"], "r2": result["r2"],
            })

    if fold_results:
        rmses = np.array([f["rmse"] for f in fold_results])
        r2s = np.array([f["r2"] for f in fold_results])
        print(f"\nCross-validation summary over {len(fold_results)} fold(s):")
        print(f"  RMSE: mean={rmses.mean():.3f}, std={rmses.std():.3f}, "
              f"min={rmses.min():.3f}, max={rmses.max():.3f} {unit}")
        print(f"  R^2:  mean={r2s.mean():.3f}, std={r2s.std():.3f}")
    else:
        print("[warning] No folds produced a result -- check MIN_POINTS_PER_WEEK and CV_MIN_TRAIN_WEEKS.")

    return fold_results

def plot_cross_validation(fold_results, variable_key=VARIABLE_TO_MODEL):
    """Two panels: test RMSE and test R^2 across walk-forward folds, by training-window size."""
    if not fold_results:
        return None
    _, display_name, unit = VARIABLE_TO_MODEL
    n_train = [f["n_train_weeks"] for f in fold_results]
    rmses = [f["rmse"] for f in fold_results]
    r2s = [f["r2"] for f in fold_results]

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 4.5))

    ax1.plot(n_train, rmses, marker="o", color="steelblue")
    ax1.set_xlabel("Number of training weeks (walk-forward)")
    ax1.set_ylabel(f"Test RMSE ({unit})")
    ax1.set_title(f"{display_name}: cross-validated RMSE by fold")
    ax1.grid(True, alpha=0.3, linestyle="--")

    ax2.plot(n_train, r2s, marker="o", color="seagreen")
    ax2.axhline(0, color="gray", linestyle=":", linewidth=1)
    ax2.set_xlabel("Number of training weeks (walk-forward)")
    ax2.set_ylabel("Test R\u00b2")
    ax2.set_title(f"{display_name}: cross-validated R\u00b2 by fold")
    ax2.grid(True, alpha=0.3, linestyle="--")

    fig.tight_layout()
    return fig

def plot_validation_progress(results):
    """Shows how validation RMSE/R^2 evolved as each successive week's data updated the shared weights."""
    if results is None:
        return None
    history = results.get("validation_history")
    if not history:
        return None
    display_name, unit = results["display_name"], results["unit"]
    weeks = [h["week_number"] for h in history]
    rmses = [h["rmse"] for h in history]

    fig, ax = plt.subplots(figsize=(10, 4))
    ax.plot(weeks, rmses, marker="o", color="steelblue")
    ax.set_xlabel("Training week (in order trained)")
    ax.set_ylabel(f"Validation RMSE ({unit})")
    ax.set_title(f"{display_name}: validation error as weeks are incrementally added")
    ax.grid(True, alpha=0.3, linestyle="--")
    fig.tight_layout()
    return fig



if __name__ == "__main__":
    results = train_incremental(VARIABLE_TO_MODEL)
    if results is not None:
        plot_validation_progress(results)
        plot_incremental_evaluation(results)
        plot_test_week_only(results)

    if RUN_CROSS_VALIDATION:
        fold_results = cross_validate(VARIABLE_TO_MODEL)
        plot_cross_validation(fold_results, VARIABLE_TO_MODEL)
    plt.show()

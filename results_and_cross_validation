# -*- coding: utf-8 -*-
"""
Walk-forward cross-validation with randomly sampled folds, plotted as boxplots.
"""

import time

import matplotlib.pyplot as plt
import numpy as np

from weekly_groupings import group_by_week
from data_visualisation import VARIABLE_TO_MODEL, number_weeks, data
from neural_network import (EPOCHS_PER_WEEK, TRIAL_WEEKS, train_incremental,
                                      plot_incremental_evaluation, plot_test_week_only)

RUN_CROSS_VALIDATION = True
CV_MIN_TRAIN_WEEKS = 3      # smallest training window a fold may use
CV_N_FOLDS = 5              # number of folds randomly drawn from all possible folds -- THE MAIN RUNTIME KNOB.
                            # Each fold retrains a fresh model on an expanding window, so cost grows with
                            # the number of folds AND with how late in the dataset each sampled fold falls.
CV_SEED = 42                # set to None for a different random draw every run

# Computed once at import time and reused (the original recomputed these inside cross_validate()).
weekly_groups = group_by_week(df=data)
week_numbers = number_weeks(weekly_groups)
ALL_WEEKS = sorted(week_numbers.values())
WEEK_TO_NUMBER = {w: n for n, w in week_numbers.items()}   # O(1) lookup instead of a scan per fold


def cross_validate(variable_key=VARIABLE_TO_MODEL, min_train_weeks=CV_MIN_TRAIN_WEEKS,
                   epochs_per_week=EPOCHS_PER_WEEK, n_folds=CV_N_FOLDS, seed=CV_SEED):
    """
    Walk-forward cross-validation with randomly sampled folds.

    Fold k trains a FRESH model on the first k weeks and tests on week k+1, so every
    fold respects chronological order (no future leakage). Instead of stepping through
    folds at a fixed interval, n_folds values of k are drawn at random (without
    replacement, reproducible via seed) from every valid k, then run in ascending order.

    Returns a list of per-fold dicts (n_train_weeks, test_week_number, test_week_start,
    rmse, mae, rRMSE) and prints a summary across folds.
    """
    _, display_name, unit = variable_key

    n_weeks = len(ALL_WEEKS)
    if n_weeks <= min_train_weeks:
        print(f"[error] {display_name}: only {n_weeks} week(s) available, need more than "
              f"CV_MIN_TRAIN_WEEKS={min_train_weeks} to run even one fold.")
        return []

    candidates = np.arange(min_train_weeks, n_weeks)
    n_pick = min(n_folds, len(candidates))
    rng = np.random.default_rng(seed)
    fold_ks = sorted(int(k) for k in rng.choice(candidates, size=n_pick, replace=False))

    total_week_trainings = sum(fold_ks)
    print(f"{display_name}: {len(fold_ks)} random fold(s) of {len(candidates)} possible "
          f"(seed={seed}), train sizes {fold_ks}; {total_week_trainings} total week-trainings.")

    fold_results = []
    cv_t0 = time.perf_counter()
    for i, k in enumerate(fold_ks):
        test_week = ALL_WEEKS[k]
        test_week_number = WEEK_TO_NUMBER[test_week]
        print(f"\n--- Fold {i + 1}/{len(fold_ks)}: train on weeks 1..{k}, "
              f"test on week {test_week_number} ({test_week.date()}) ---")

        result = train_incremental(variable_key, trial_weeks=TRIAL_WEEKS[:k], validation_weeks=[],
                                   test_weeks=[test_week], epochs_per_week=epochs_per_week)

        if i == 0 and len(fold_ks) > 1:
            elapsed = time.perf_counter() - cv_t0
            est_total = elapsed * total_week_trainings / k
            print(f"[estimate] first fold took {elapsed:.1f}s -- projected total for all "
                  f"{len(fold_ks)} fold(s): ~{est_total:.0f}s ({est_total / 60:.1f} min). "
                  f"Lower CV_N_FOLDS or raise CV_MIN_TRAIN_WEEKS to cut this down.")

        if result is not None and "rmse" in result:
            fold_results.append({
                "fold": i + 1, "n_train_weeks": k,
                "test_week_number": test_week_number, "test_week_start": test_week,
                "rmse": result["rmse"], "mae": result["mae"], "rRMSE": result["rrmse"],
            })

    if fold_results:
        rmses = np.array([f["rmse"] for f in fold_results])
        rrmses = np.array([f["rRMSE"] for f in fold_results])
        print(f"\nCross-validation summary over {len(fold_results)} fold(s):")
        print(f"  RMSE:  mean={rmses.mean():.3f}, std={rmses.std():.3f}, "
              f"min={rmses.min():.3f}, max={rmses.max():.3f} {unit}")
        print(f"  rRMSE: mean={rrmses.mean():.3f}, std={rrmses.std():.3f}")
    else:
        print("[warning] No folds produced a result -- check MIN_POINTS_PER_WEEK and CV_MIN_TRAIN_WEEKS.")

    return fold_results


def plot_cross_validation(fold_results, variable_key=VARIABLE_TO_MODEL):
    """Boxplots of test RMSE, MAE and rRMSE across the sampled folds (individual folds overlaid as points)."""
    if not fold_results:
        return None
    _, display_name, unit = variable_key

    metrics = [
        ("rmse", f"RMSE ({unit})", "steelblue"),
        ("mae", f"MAE ({unit})", "darkorange"),
        ("rRMSE", "rRMSE", "seagreen"),
    ]
    rng = np.random.default_rng(0)   # fixed jitter so the plot is stable between runs

    fig, axes = plt.subplots(1, len(metrics), figsize=(12, 4.5))
    for ax, (key, label, colour) in zip(axes, metrics):
        values = np.array([f[key] for f in fold_results], dtype=float)
        ax.boxplot(values, widths=0.5, showmeans=True, patch_artist=True,
                   boxprops=dict(facecolor=colour, alpha=0.35, edgecolor=colour),
                   medianprops=dict(color="black", linewidth=1.5),
                   meanprops=dict(marker="D", markerfacecolor="white", markeredgecolor="black"),
                   whiskerprops=dict(color=colour), capprops=dict(color=colour),
                   flierprops=dict(marker="x", markeredgecolor="red"))
        ax.scatter(1 + rng.uniform(-0.1, 0.1, len(values)), values,
                   color=colour, edgecolor="black", alpha=0.8, zorder=3, s=25)
        ax.set_xticks([1])
        ax.set_xticklabels([f"n={len(values)} folds"])
        ax.set_ylabel(label)
        ax.set_title(label)
        ax.grid(True, axis="y", alpha=0.3, linestyle="--")

    fig.suptitle(f"{display_name}: walk-forward cross-validation (random folds)")
    fig.tight_layout()
    return fig


if __name__ == "__main__":
    results = train_incremental(VARIABLE_TO_MODEL)

    if results is not None:
        plot_incremental_evaluation(results)
        plot_test_week_only(results)

    if RUN_CROSS_VALIDATION:
        fold_results = cross_validate(VARIABLE_TO_MODEL)
        plot_cross_validation(fold_results, VARIABLE_TO_MODEL)
    plt.show()

"""
Import a sensor-log CSV and split it into per-variable arrays
========================================================================
Expects a comma-delimited CSV with a header row:

    id,sensorid,devicetype,jsondata,status,processing_errors,createdate,processdate

`jsondata` is a JSON array, standard CSV-quoted (fields containing
commas/quotes are wrapped in "..." with internal quotes doubled).
Each element looks like:

    {"values": [{"time": 1702273965, "value": 603}],
     "variable": {"id": 67, "name": "Carbon dioxide", "unit": "ppm", ...}}

This version reads the whole file at once with pandas (vectorized,
C-level CSV parsing) and vectorizes everything downstream that can be
vectorized: date parsing runs once over a whole column instead of once
per row, and per-variable arrays are built with a single reindex +
to_numpy() call rather than a manual list-per-variable loop. Only the
JSON parsing itself stays row-wise -- each blob is an independent
document, so there's no way around visiting each one -- but even that
runs as a single vectorized .map() rather than an explicit for-loop.

Produces the same outputs as before: row_ids, timestamps, created_at,
processed_at, and one NumPy array per sensor variable (co2,
temperature, humidity, pressure, ...), all aligned by index.
========================================================================
"""

import json

import pandas as pd
import numpy as np

PATH = "5EnvSensor_MayToDec2024_180kRows.csv"  # Path to the CSV file; change as needed.
DAY_BOUND = 14
# The variables we want as named arrays. Add/remove names here -- the
# key must match the JSON "name" field exactly. Any variable name that
# never shows up anywhere in the file simply becomes an all-NaN column,
# same as before.
# Maps the exact JSON "name" field to the short column name we want to use.
VARIABLE_NAMES = [
    "Battery",
    "Carbon dioxide",
    "Humidity",
    "Formaldehyde",
    "Pressure",
    "Temperature",
    "Light Volatile Organic Compounds",
    "Particulate matter 1",
    "Particulate matter 4",
    "Particulate matter 2.5",
    "Particulate matter 10",
]


def _safe_json_loads(text):
    """
    Checks for bad JSON and yields ``None`` so the caller can drop the row instead of crashing
    
    Args:
        text: Raw JSON string from the ``jsondata`` column.
    
    Returns:
        JSON text
    """
    try:
        return json.loads(text) # Decode the JSON array into Python objects.
    except (json.JSONDecodeError, TypeError):# Malformed text, or NaN/None input.
        return None # Signal "unreadable" to the caller.


def _flatten(readings):
    """
    Parses one ``jsondata`` string into a flat dict of readings.
 
    Args:
        readings: JSON text after being checked by _safe_json_loads
 
    Returns:
        A dict like ``{"Carbon dioxide": 603, ..., "_time": 1702273965}``, where
        ``_time`` is the row's Unix timestamp in seconds (UTC), or ``None`` if
        the JSON could not be parsed.
    """
    if not isinstance(readings, list):
        return {"_time": None}
    record = {}
    row_time = None # Start with no timestamp; set it if one is found.
    for entry in readings: # Each entry is one variable's reading.
        variable = entry.get("variable", {}) # List of {"time", "value"} points.
        name = variable.get("name")
        values = entry.get("values", [])
        if not values: # Skip variables that have no reading.
            continue                      # no reading at all for this variable
        point = values[0]                 # first/only reading per variable
        if "time" in point:
            row_time = point["time"]      # shared timestamp for the row
        if name is not None: # Ignore readings with no variable name.
            record[name] = point.get("value")  # None if value is missing
    record["_time"] = row_time
    return record


def load_sensor_data(path=PATH):
    """
    Reads CSV, parses JSON, removes exact duplicates, and filters out lone points
    having fewer than 20 readings within a 2-week window either side.
    """
    # ------------------------------------------------------------------
    # 1. Read the whole file at once (vectorized C-level CSV parsing).
    # ------------------------------------------------------------------
    raw = pd.read_csv(path, dtype=str) 

    # ------------------------------------------------------------------
    # 2. Parse the JSON blobs: one vectorized .map() call, with bad rows
    #    dropped via a single boolean mask.
    # ------------------------------------------------------------------
    readings_col = raw["jsondata"].map(_safe_json_loads) 
    bad = readings_col.isna() 
    if bad.any():
        print(f"[skip] {bad.sum()} row(s) with unreadable jsondata: ids {raw.loc[bad, 'id'].tolist()}") 
    raw = raw.loc[~bad].reset_index(drop=True) 
    readings_col = readings_col.loc[~bad].reset_index(drop=True) 

    # ------------------------------------------------------------------
    # 3. Flatten each row to one dict, then build the wide table in a
    #    single DataFrame call.
    # ------------------------------------------------------------------
    records = readings_col.map(_flatten) 
    wide = pd.DataFrame(records.tolist()) 

    # ------------------------------------------------------------------
    # 3b. Drop exact duplicate readings.
    # ------------------------------------------------------------------
    dup_mask = wide.duplicated(keep="first") 
    raw = raw.loc[~dup_mask].reset_index(drop=True) 
    wide = wide.loc[~dup_mask].reset_index(drop=True) 

    # ------------------------------------------------------------------
    # 3c. Remove lone points with < 20 readings within two weeks either side
    # ------------------------------------------------------------------
    temp_timestamps = pd.to_datetime(wide["_time"], unit="s", utc=True) 
    temp_df = pd.DataFrame({
        "orig_idx": np.arange(len(wide)),
        "timestamps": temp_timestamps
    })

    valid_time_mask = temp_df["timestamps"].notna()
    sorted_temp = temp_df[valid_time_mask].sort_values("timestamps").reset_index(drop=True)

    if len(sorted_temp) > 0:
        t_ns = sorted_temp["timestamps"].values.astype("int64")
        window_ns = pd.Timedelta(days=DAY_BOUND).value  # Two weeks either side

        left = np.searchsorted(t_ns, t_ns - window_ns, side="left")
        right = np.searchsorted(t_ns, t_ns + window_ns, side="right")
        sorted_temp["neighbor_count"] = right - left

        lone_mask_sorted = sorted_temp["neighbor_count"] < 20
        lone_rows = sorted_temp[lone_mask_sorted]

        for _, row in lone_rows.iterrows():
            print(f"[warning] Removing lone point at timestamp {row['timestamps']}: only {sorted_temp.loc[row.name, 'neighbor_count']} reading(s) found within 2 weeks either side.")

        lone_orig_indices = sorted_temp.loc[lone_mask_sorted, "orig_idx"].values
        keep_mask = np.ones(len(wide), dtype=bool)
        keep_mask[lone_orig_indices] = False
    else:
        keep_mask = np.ones(len(wide), dtype=bool)

    raw = raw.loc[keep_mask].reset_index(drop=True) 
    wide = wide.loc[keep_mask].reset_index(drop=True) 

    # Guarantee every expected variable exists as a column (missing ones
    # become all-NaN) in one vectorized reindex.
    wide_vars = wide.reindex(columns=VARIABLE_NAMES) 

    # ------------------------------------------------------------------
    # 4. Vectorized date handling: each column is converted once.
    # ------------------------------------------------------------------
    row_ids = raw["id"].to_numpy() 
    timestamps = pd.to_datetime(wide["_time"], unit="s", utc=True).to_numpy() 
    created_at = pd.to_datetime(raw["createdate"], utc=True).to_numpy() 
    processed_at = pd.to_datetime(raw["processdate"], utc=True).to_numpy() 

    # ------------------------------------------------------------------
    # 5. Pull each named variable out as a float NumPy array.
    # ------------------------------------------------------------------
    arrays = {name: wide_vars[name].to_numpy(dtype=float) for name in VARIABLE_NAMES} 

    AVAILABLE_VARIABLES = {
        "battery": (arrays["Battery"], "Battery", "V"), 
        "co2": (arrays["Carbon dioxide"], "Carbon dioxide", "ppm"), 
        "humidity": (arrays["Humidity"], "Humidity", "HR%"), 
        "formaldehyde": (arrays["Formaldehyde"], "Formaldehyde", "\u00b5g/m3"), 
        "pressure": (arrays["Pressure"], "Pressure", "mb"), 
        "temperature": (arrays["Temperature"], "Temperature", "\u00b0C"), 
        "voc": (arrays["Light Volatile Organic Compounds"], "Light Volatile Organic Compounds", "ppb"), 
        "pm1": (arrays["Particulate matter 1"], "Particulate matter 1", "\u00b5g/m3"), 
        "pm4": (arrays["Particulate matter 4"], "Particulate matter 4", "\u00b5g/m3"), 
        "pm25": (arrays["Particulate matter 2.5"], "Particulate matter 2.5", "\u00b5g/m3"),
        "pm10": (arrays["Particulate matter 10"], "Particulate matter 10", "\u00b5g/m3")
    }

    return raw, wide, row_ids, timestamps, created_at, processed_at, AVAILABLE_VARIABLES


# Backward-compatible module-level exports
raw, wide, row_ids, timestamps, created_at, processed_at, AVAILABLE_VARIABLES = load_sensor_data()

VARIABLE_TO_MODEL = AVAILABLE_VARIABLES["co2"]
TIME_TO_MODEL = timestamps

"""
Import a sensor-log CSV into ONE master DataFrame
========================================================================
Expects a comma-delimited CSV with a header row:

    id,sensorid,devicetype,jsondata,status,processing_errors,createdate,processdate

`jsondata` is a JSON array; each element looks like:

    {"values": [{"time": 1702273965, "value": 603}],
     "variable": {"id": 67, "name": "Carbon dioxide", "unit": "ppm", ...}}

Design: single source of truth
------------------------------------------------------------------------
Everything lives in `data`, one DataFrame with columns

    id, sensorid, timestamp, created_at, processed_at, <one float column per variable>

Nothing else holds a copy of the readings:

  * VARIABLES is metadata only (display name + unit), keyed by column name.
  * Other modules get a variable with `data["co2"]` (a reference, no copy)
    and a time range with `data.iloc[a:b]` / `series.iloc[a:b]` (views).
  * The raw JSON text, the intermediate "wide" frame, the per-variable
    arrays and the filter temporaries are all discarded; every filter
    (duplicates, undated rows, lone points) is combined into ONE row
    selection, so the table is only materialised once.
  * Rows are sorted by timestamp, so any week / date range is a contiguous
    slice of the master table.
========================================================================
"""

import json

import numpy as np
import pandas as pd

PATH = "5EnvSensor_MayToDec2024_180kRows.csv"  # Path to the CSV file; change as needed.
DAY_BOUND = 14          # a reading is "lone" if too few neighbours lie within +/- this many days
MIN_NEIGHBOURS = 20     # ...fewer than this many readings (including itself)

# Two rows are duplicates only if ALL their readings, their timestamp AND every column listed here match.
# "sensorid" stops identical readings from different sensors being merged. Add "createdate" and/or
# "processdate" to be stricter (a re-sent message with a new processdate would then be KEPT); never add "id"
# unless every id is meant to be distinct -- it is unique per row, so nothing would ever count as a duplicate.
DEDUP_EXTRA = ("sensorid",)

# (column name in `data`, exact JSON "name" field, unit)
VARIABLE_SPEC = (
    ("battery",      "Battery",                          "V"),
    ("co2",          "Carbon dioxide",                   "ppm"),
    ("humidity",     "Humidity",                         "HR%"),
    ("formaldehyde", "Formaldehyde",                     "\u00b5g/m3"),
    ("pressure",     "Pressure",                         "mb"),
    ("temperature",  "Temperature",                      "\u00b0C"),
    ("voc",          "Light Volatile Organic Compounds", "ppb"),
    ("pm1",          "Particulate matter 1",             "\u00b5g/m3"),
    ("pm4",          "Particulate matter 4",             "\u00b5g/m3"),
    ("pm25",         "Particulate matter 2.5",           "\u00b5g/m3"),
    ("pm10",         "Particulate matter 10",            "\u00b5g/m3"),
)

VALUE_COLUMNS = [key for key, _, _ in VARIABLE_SPEC]
_NAME_TO_KEY = {name: key for key, name, _ in VARIABLE_SPEC}

# Metadata only: column name -> (display name, unit). Holds no readings.
VARIABLES = {key: (name, unit) for key, name, unit in VARIABLE_SPEC}


def _parse_row(text):
    """
    Parses one ``jsondata`` string straight into a flat dict of readings.

    Returns:
        ``None`` if the JSON is unreadable (caller drops the row), otherwise a
        dict like ``{"co2": 603, ..., "_time": 1702273965}`` where ``_time`` is
        the Unix timestamp in seconds (NaN if absent). Variables not listed in
        VARIABLE_SPEC are ignored.
    """
    try:
        readings = json.loads(text)
    except (json.JSONDecodeError, TypeError):  # malformed text, or NaN input
        return None
    if not isinstance(readings, list):
        return {"_time": np.nan}

    record = {}
    row_time = np.nan
    for entry in readings:
        values = entry.get("values", [])
        if not values:
            continue
        point = values[0]  # first/only reading per variable
        if "time" in point:
            row_time = point["time"]  # shared timestamp for the row
        key = _NAME_TO_KEY.get(entry.get("variable", {}).get("name"))
        if key is not None:
            record[key] = point.get("value")
    record["_time"] = row_time
    return record


def load_sensor_data(path=PATH):
    """
    Reads the CSV and returns the single master DataFrame.

    Removes unreadable rows, duplicates (same readings + timestamp + DEDUP_EXTRA columns),
    undated rows and lone points
    (< MIN_NEIGHBOURS readings within DAY_BOUND days either side), and sorts
    the result by timestamp.
    """
    # 1. Read only the columns we need (vectorised C-level CSV parsing).
    usecols = list(dict.fromkeys(["id", "jsondata", "createdate", "processdate", *DEDUP_EXTRA]))
    raw = pd.read_csv(path, dtype=str, usecols=usecols)

    # 2. Parse JSON once per row; the raw text is popped out and freed.
    parsed = raw.pop("jsondata").map(_parse_row)
    bad = parsed.isna().to_numpy()
    if bad.any():
        print(f"[skip] {bad.sum()} row(s) with unreadable jsondata: ids {raw.loc[bad, 'id'].tolist()}")
        raw = raw.loc[~bad]
        parsed = parsed.loc[~bad]

    # 3. One wide table, one float column per variable (missing -> all-NaN).
    data = pd.DataFrame(parsed.tolist(), columns=[*VALUE_COLUMNS, "_time"]).astype(float)
    del parsed

    for col in dict.fromkeys(["id", "createdate", "processdate", *DEDUP_EXTRA]):
        data[col] = raw[col].to_numpy()
    del raw

    # A duplicate matches on readings + timestamp + every DEDUP_EXTRA column (not just readings + time)
    dup = data.duplicated(subset=[*VALUE_COLUMNS, "_time", *DEDUP_EXTRA], keep="first").to_numpy()
    if DEDUP_EXTRA:
        readings_only = data.duplicated(subset=[*VALUE_COLUMNS, "_time"], keep="first").to_numpy()
        spared = readings_only & ~dup
        if spared.any():
            print(f"[info] keeping {spared.sum()} row(s) whose readings and timestamp match another row "
                  f"but differ in {', '.join(DEDUP_EXTRA)}")

    # 4. Work out which rows survive, and in what order, on a bare numpy array.
    t = data["_time"].to_numpy()                       # Unix seconds, NaN if undated
    undated = np.isnan(t)
    if dup.any():
        print(f"[info] removing {dup.sum()} duplicate reading(s)")
    if (undated & ~dup).any():
        print(f"[warning] {(undated & ~dup).sum()} reading(s) had no timestamp and were removed")

    candidates = np.flatnonzero(~dup & ~undated)
    order = candidates[np.argsort(t[candidates], kind="stable")]   # time-sorted row positions
    t_sorted = t[order]

    window = DAY_BOUND * 86400.0
    neighbours = (np.searchsorted(t_sorted, t_sorted + window, side="right")
                  - np.searchsorted(t_sorted, t_sorted - window, side="left"))
    lone = neighbours < MIN_NEIGHBOURS
    for ts, n in zip(pd.to_datetime(t_sorted[lone], unit="s", utc=True), neighbours[lone]):
        print(f"[warning] Removing lone point at {ts}: only {n} reading(s) within "
              f"{DAY_BOUND} days either side.")
    order = order[~lone]

    # 5. Materialise the master table exactly once.
    data = data.iloc[order].reset_index(drop=True)

    # 6. Dates converted once per column, taken from final_data's OWN rows. (Converting the unfiltered
    #    `data` columns and inserting them here would attach each timestamp to the wrong row, because
    #    final_data has been filtered and re-sorted.)
    data.insert(0, "id", data.pop("id"))
    data["timestamp"] = pd.to_datetime(data.pop("_time"), unit="s", utc=True)
    data["created_at"] = pd.to_datetime(data.pop("createdate"), utc=True)
    data["processed_at"] = pd.to_datetime(data.pop("processdate"), utc=True)
    id_cols = ["id", *[c for c in DEDUP_EXTRA if c != "id"]]
    data = data[[*id_cols, "timestamp", "created_at", "processed_at", *VALUE_COLUMNS]]
    return data   # `data` is the unfiltered table: data[dup] shows exactly what was removed


# Module-level master table. Everything else should reference this object.
data = load_sensor_data()

TIME_COL = "timestamp"
VARIABLE_TO_MODEL = "co2"   # column name in `data`; look up metadata in VARIABLES
